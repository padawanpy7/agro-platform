# Copia esto a `.env` (gitignored) y completa lo que necesites. Lo que ya este en el ambiente
# PISA a este archivo: se puede sobreescribir una variable en una corrida puntual sin editar nada.
#
# Regla del proyecto: las credenciales van aca con su NOMBRE REAL, nunca derivadas ni aliasadas.

# --- VPS de la plataforma (SOLO LECTURA desde este repo) ---------------------------------
# PENDIENTE: `node agro.js ssh-ro` todavia es el script del repo de origen y pide credenciales
# LDAP/Oracle. Estas variables son para cuando se adapte. La lista blanca esta en
# scripts/lib/ssh-ro-core.js. Escribir en la plataforma es trabajo de ../infra-platform.
VPS_HOST=
VPS_USUARIO=
VPS_SSH_KEY=

# --- Base de datos del producto -----------------------------------------------------------
# PostgreSQL + TimescaleDB + PostGIS. En local, la de docker; en staging, la del cluster.
#
# HAY TRES CONEXIONES DISTINTAS Y NO SE PUEDEN MEZCLAR, y el motivo no es prolijidad:
#   agro_admin    dueño de las tablas, corre las migraciones. En docker es el SUPERUSUARIO, y
#                 UN SUPERUSUARIO NO ESTA SUJETO A ROW-LEVEL SECURITY. Si la API apunta aca,
#                 todos los checks siguen en verde y cada cliente ve los datos de todos.
#   agro_app      la API del producto. Es el unico que la API usa. SIEMPRE con app.tenant_id.
#   agro_auth     solo el login: ve identidades y hashes, y ni un dato de cliente.
# (mas `agro_control`, que solo da de alta clientes, y lo usa la app de gestion del dueño.)
PGHOST=
PGPORT=5432
PGDATABASE=

# Migraciones y `apply-schema.sh`. En docker es POSTGRES_USER/POSTGRES_PASSWORD.
PGUSER=
PGPASSWORD=

# La API. NUNCA el de arriba.
AGRO_APP_USER=agro_app
AGRO_APP_PASSWORD=

# El login, y nada mas que el login.
AGRO_AUTH_USER=agro_auth
AGRO_AUTH_PASSWORD=

# --- Broker MQTT (ingesta del campo) ------------------------------------------------------
MQTT_URL=
MQTT_USUARIO=
MQTT_PASSWORD=

# --- Copernicus / Sentinel-2 (NDVI por parcela) -------------------------------------------
# La cuenta es gratuita; la credencial NO se versiona igual.
COPERNICUS_USUARIO=
COPERNICUS_PASSWORD=
